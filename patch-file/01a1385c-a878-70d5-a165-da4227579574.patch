+const puppeteer=require('/home/user/.cache/nl-qa/node_modules/puppeteer-core');const chromium=require('/home/user/.cache/nl-qa/node_modules/@sparticuz/chromium/build/index.js').default;const{AxePuppeteer}=require('/home/user/.cache/nl-qa/node_modules/@axe-core/puppeteer');const fs=require('fs');
+(async()=>{const b=await puppeteer.launch({args:chromium.args,executablePath:await chromium.executablePath(),headless:true});const p=await b.newPage();await p.setRequestInterception(true);p.on('request',r=>r.url().startsWith('http://localhost:8000')||r.url().startsWith('data:')?r.continue():r.abort());let result=[];
+for(const path of ['apps/landing/services/index.html','apps/web/projects/index.html','apps/admin/payments/01a10a2c-2d0e-7499-b769-967d17a42197/index.html'])for(const width of [390,1440])for(const theme of ['light','dark']){await p.setViewport({width,height:960});await p.goto('http://localhost:8000/'+path);await p.evaluate(t=>document.documentElement.dataset.theme=t,theme);await new Promise(r=>setTimeout(r,1200));let axe;try{axe=await new AxePuppeteer(p).analyze()}catch(error){await new Promise(r=>setTimeout(r,1500));axe=await new AxePuppeteer(p).analyze()}result.push({path,width,theme,scroll:await p.evaluate(()=>document.documentElement.scrollWidth),axe:axe.violations.map(v=>v.id)});
+if(path.includes('/services/')&&width===390&&theme==='light'){await p.$eval('.footer',e=>e.scrollIntoView());await new Promise(r=>setTimeout(r,500));await p.screenshot({path:'upgrade-v2/evidence/footer-final-mobile.webp',type:'webp',quality:75});}
+if(path.includes('/admin/')&&width===1440&&theme==='light'){await p.$eval('.main',e=>e.scrollTop=e.scrollHeight);await new Promise(r=>setTimeout(r,750));await p.screenshot({path:'upgrade-v2/evidence/payment-desktop-bottom.webp',type:'webp',quality:75});result.push({name:'admin-internal-scroll',value:await p.$eval('.main',e=>({top:e.scrollTop,unrevealed:[...e.querySelectorAll('.reveal')].filter(n=>getComputedStyle(n).opacity==='0').length}))});}}
+await p.goto('http://localhost:8000/apps/landing/index.html');await p.click('.fab-btn');const expanded=await p.$eval('.fab-btn',e=>e.getAttribute('aria-expanded'));await p.keyboard.press('Escape');result.push({name:'prototype-menu-Escape',expanded,closed:await p.$eval('.fab-btn',e=>e.getAttribute('aria-expanded')==='false'&&e===document.activeElement)});
+// Runtime-file unavailable fallback leaves all essential content readable.
+await p.setCacheEnabled(false);await p.setRequestInterception(false);await p.setRequestInterception(true);p.removeAllListeners('request');p.on('request',r=>r.url().includes('proto-motion.js')?r.abort():r.url().startsWith('http://localhost:8000')||r.url().startsWith('data:')?r.continue():r.abort());await p.goto('http://localhost:8000/apps/landing/index.html');await new Promise(r=>setTimeout(r,400));result.push({name:'missing-motion-runtime',rootClass:await p.$eval('html',e=>e.className),hidden:await p.$$eval('main .reveal,main h1',es=>es.filter(e=>getComputedStyle(e).opacity==='0').length)});
