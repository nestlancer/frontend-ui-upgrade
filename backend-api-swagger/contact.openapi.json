    "/api/v1/admin/contact": {
      "get": {
        "operationId": "ContactAdminController_findAll",
        "summary": "List all inquiries",
        "description": "Retrieve a paginated list of all contact inquiries received with statistics.",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Alias of limit",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Sort field:order (e.g., createdAt:desc)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter by inquiry status",
            "schema": {
              "enum": [
                "NEW",
                "READ",
                "RESPONDED",
                "ARCHIVED",
                "SPAM"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Field to sort by",
            "schema": {
              "default": "createdAt",
              "example": "createdAt",
              "type": "string"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "default": "DESC",
              "enum": [
                "ASC",
                "DESC"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelopeDto"
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "data",
                        "metadata"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "success"
                          ]
                        },
                        "data": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "metadata": {
                          "$ref": "#/components/schemas/ResponseMetadataDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Contact - Admin"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
