    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthPublicController_login",
        "summary": "User login",
        "description": "Authenticate with credentials to obtain a session or trigger 2FA if enabled.",
        "parameters": [
          {
            "name": "user-agent",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "origin",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "referer",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "host",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-forwarded-host",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
