                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelopeDto"
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "data",
                        "metadata"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "success"
                          ]
                        },
                        "data": {
                          "$ref": "#/components/schemas/LoginTokensDto"
                        },
                        "metadata": {
                          "$ref": "#/components/schemas/ResponseMetadataDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
