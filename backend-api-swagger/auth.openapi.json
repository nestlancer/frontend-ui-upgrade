              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully. Please verify your email.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessEnvelopeDto"
                    },
                    {
                      "type": "object",
